<Window x:Class="FilmRatingRus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ФильмОценкаРус"
        Height="700"
        Width="1200">

	<Grid Margin="10">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="2*"/>
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="2*"/>
			<RowDefinition Height="2*"/>
		</Grid.RowDefinitions>


		<!-- 1 область -->

		<GroupBox Header="Список фильмов"
                  Grid.Row="0"
                  Grid.Column="0"
                  Margin="5">

			<ListView ItemsSource="{Binding FilteredMovies}"
                      SelectedItem="{Binding SelectedMovie}">

				<ListView.View>
					<GridView>

						<GridViewColumn Header="Название"
                                        Width="150"
                                        DisplayMemberBinding="{Binding Name}"/>

						<GridViewColumn Header="Жанр"
                                        Width="100"
                                        DisplayMemberBinding="{Binding Genre}"/>

						<GridViewColumn Header="Режиссер"
                Width="150"
                DisplayMemberBinding="{Binding Director}"/>

						<GridViewColumn Header="Год"
                                        Width="70"
                                        DisplayMemberBinding="{Binding Year}"/>



						<GridViewColumn Header="Рейтинг"
                                        Width="80"
                                        DisplayMemberBinding="{Binding Rating}"/>

					</GridView>
				</ListView.View>
			</ListView>
		</GroupBox>


		<!-- 2 область -->

		<GroupBox Header="Добавить новый фильм в коллекцию"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="5">

			<StackPanel Margin="10">

				<TextBlock Text="Название" Width="544"/>
				<TextBox Text="{Binding MovieName}"/>

				<TextBlock Text="Жанр" Margin="0,10,0,0"/>
				<TextBox Text="{Binding Genre}"/>

				<TextBlock Text="Год" Margin="0,10,0,0"/>
				<TextBox Text="{Binding Year}"/>

				<TextBlock Text="Режиссер" Margin="0,10,0,0"/>
				<TextBox Text="{Binding Director}"/>

				<TextBlock Text="Рейтинг" Margin="0,10,0,0"/>
				<TextBox Text="{Binding Rating}"/>

				<Button Content="Добавить"
                        Margin="0,10,0,0"
                        Command="{Binding AddMovieCommand}"/>

				<Button Content="Удалить"
                        Margin="0,10,0,0"
                        Command="{Binding DeleteMovieCommand}"/>

				<Button Content="Показать все"
                        Margin="0,10,0,0"
                        Command="{Binding ShowAllCommand}"/>

			</StackPanel>
		</GroupBox>


		<!-- 3 область -->

		<GroupBox Header="Поиск и сортировка"
                  Grid.Row="1"
                  Grid.Column="0"
                  Margin="5">

			<StackPanel Margin="10">

				<TextBlock Text="Поиск по жанру"/>

				<ComboBox ItemsSource="{Binding Genres}"
                          SelectedItem="{Binding SelectedGenre}"
                          Margin="0,5,0,0"/>

				<Button Content="Найти"
                        Margin="0,5,0,0"
                        Command="{Binding SearchByGenreCommand}"/>

				<TextBlock Text="Поиск по годам"
                           Margin="0,15,0,0"/>

				<StackPanel Orientation="Horizontal">
					<TextBox Width="100"
                             Text="{Binding StartYear}"/>

					<TextBox Width="100"
                             Margin="10,0,0,0"
                             Text="{Binding EndYear}"/>
				</StackPanel>

				<Button Content="Поиск"
                        Margin="0,5,0,0"
                        Command="{Binding SearchByYearCommand}"/>

				<TextBlock Text="Сортировка"
                           Margin="0,15,0,0"/>

				<Button Content="По возрастанию"
                        Margin="0,5,0,0"
                        Command="{Binding SortAscendingCommand}"/>

				<Button Content="По убыванию"
                        Margin="0,5,0,0"
                        Command="{Binding SortDescendingCommand}"/>

			</StackPanel>
		</GroupBox>


		<!-- 4 область -->

		<GroupBox Header="Список режиссеров"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="5">

			<ListView ItemsSource="{Binding Directors}">

				<ListView.View>
					<GridView>

						<GridViewColumn Header="ФИО"
                                        Width="150"
                                        DisplayMemberBinding="{Binding FullName}"/>

						<GridViewColumn Header="Количество фильмов"
                                        Width="150"
                                        DisplayMemberBinding="{Binding MovieCount}"/>

						<GridViewColumn Header="Средний рейтинг"
                                        Width="130"
                                        DisplayMemberBinding="{Binding AverageRating}"/>

						<GridViewColumn Header="Начало"
                                        Width="80"
                                        DisplayMemberBinding="{Binding StartYear}"/>

						<GridViewColumn Header="Конец"
                                        Width="80"
                                        DisplayMemberBinding="{Binding EndYear}"/>

					</GridView>
				</ListView.View>
			</ListView>
		</GroupBox>


	</Grid>
</Window>
